# Absolute shared data directory (same for web, importer and worker)
ATLAS_DATA_ROOT=
ATLAS_APP_ROOT=
ATLAS_DB=
# Optional location for the local public live ledger.
ATLAS_LIVE_DB=
ATLAS_LIVE_PYTHON=

# AnyModel: only source rows with ai_allowed=true may be sent here.
ATLAS_ANYMODEL_URL=
ATLAS_ANYMODEL_API_KEY=
ATLAS_ANYMODEL_MODEL=
ATLAS_ANYMODEL_MAX_TOKENS=1200
ATLAS_ANYMODEL_TIMEOUT_SECONDS=90
ATLAS_LANGSEARCH_URL=https://api.langsearch.com/v1
ATLAS_LANGSEARCH_API_KEY=
# Conservative fallback for unresolved, explicitly named facilities only.
ATLAS_LANGSEARCH_MAX_PER_RUN=3

# Optional Telegram MTProto connector. Keep the session file outside Git.
# Create api_id/api_hash at https://my.telegram.org/apps; a bot token is not enough.
ATLAS_TELEGRAM_API_ID=
ATLAS_TELEGRAM_API_HASH=
ATLAS_TELEGRAM_SESSION=

# Reserve keys from separately provisioned LangSearch accounts, comma separated.
ATLAS_LANGSEARCH_API_KEYS=
# Switch endpoint when running a private/contracted Nominatim service.
ATLAS_NOMINATIM_URL=https://nominatim.openstreetmap.org
